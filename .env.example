# DocStudio Environment Configuration
# Copy this file to .env and fill in your actual values

# ============================================================================
# LLM API Configuration (Azure OpenAI or OpenAI)
# ============================================================================

# For Azure OpenAI (recommended for production)
OPENAI_API_KEY=your_azure_openai_key_here
OPENAI_API_BASE=https://your-resource-name.openai.azure.com
OPENAI_API_VERSION=2024-02-15-preview
OPENAI_API_TYPE=azure
OPENAI_API_DEPLOYMENT_NAME=gpt-4o

# For OpenAI.com API (alternative)
# OPENAI_API_KEY=sk-...
# OPENAI_API_BASE=https://api.openai.com/v1
# OPENAI_API_TYPE=openai
# OPENAI_MODEL=gpt-4o-mini

# ============================================================================
# Application Configuration
# ============================================================================

# Database path (default: docstudio.db)
DOCSTUDIO_DB=/data/docstudio.db

# Enable SQLite logging (1=enabled, 0=disabled)
DOCSTUDIO_SQLITE=1

# Enable MLflow tracking (1=enabled, 0=disabled)
# DOCSTUDIO_MLFLOW=1

# MLflow tracking URI (for experiment tracking)
MLFLOW_TRACKING_URI=file:/mlruns

# Streamlit UI API URL (used by UI container to connect to API)
# In Docker: http://api:8000
# Local dev: http://localhost:8000
STREAMLIT_API_URL=http://api:8000

# Tokenizers parallelism (suppress HuggingFace warnings)
TOKENIZERS_PARALLELISM=false

# ============================================================================
# Logging Configuration
# ============================================================================

# Log level (DEBUG, INFO, WARNING, ERROR)
LOG_LEVEL=INFO

# ============================================================================
# Retrieval Configuration
# ============================================================================

# Default embedding model
# EMBEDDING_MODEL=BAAI/bge-small-en-v1.5

# Default number of documents to retrieve
# DEFAULT_K=5

# Default MMR lambda (0=diversity, 1=relevance)
# DEFAULT_MMR_LAMBDA=0.6
